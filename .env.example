# Copy to .env and fill in. See README.md for what each value does.

# Store under test
# Format: https://<your-store>.myshopify.com/
STORE_BASE_URL=
STORE_PASSWORD=
PREVIEW_THEME_ID=

# Page paths
EVENT_PATH=/pages/my-events
MY_LOOKS_PATH=/pages/my-looks

# Mailosaur — used to read the sign-in OTP emails
MAILOSAUR_API_KEY=
MAILOSAUR_SERVER_ID=

# Optional: fixed customer inbox for the event session (a Mailosaur address).
# Leave blank to generate a new one per run.
CUSTOMER_EMAIL=
